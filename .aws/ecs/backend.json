{
  "family": "stockspoon-v2-prod-backend",
  "taskRoleArn": "arn:aws:iam::250832562715:role/stockspoon-v2-prod-backend-task-role",
  "executionRoleArn": "arn:aws:iam::250832562715:role/stockspoon-v2-prod-ecs-task-execution-role",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "IMAGE_SET_BY_CD",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "REDIS_HOST",
          "value": "stockspoon-v2-prod-valkey-kmikux.serverless.apn2.cache.amazonaws.com"
        },
        {
          "name": "REDIS_CLUSTER_MODE",
          "value": "true"
        },
        {
          "name": "AWS_REGION",
          "value": "ap-northeast-2"
        },
        {
          "name": "DB_WRITE_REPLAY_ENABLED",
          "value": "true"
        },
        {
          "name": "DB_WRITE_REPLAY_QUEUE_URL",
          "value": "https://sqs.ap-northeast-2.amazonaws.com/250832562715/stockspoon-v2-prod-db-write-replay.fifo"
        },
        {
          "name": "ORDER_QUEUE_ENABLED",
          "value": "false"
        },
        {
          "name": "ORDER_QUEUE_CONSUMER_ENABLED",
          "value": "true"
        },
        {
          "name": "ORDER_QUEUE_URL",
          "value": "https://sqs.ap-northeast-2.amazonaws.com/250832562715/stockspoon-v2-prod-order.fifo"
        },
        {
          "name": "DB_WRITE_REPLAY_PROXYSQL_ERROR_CODES",
          "value": "9001,1290"
        },
        {
          "name": "AUTH_COOKIE_SECURE",
          "value": "true"
        },
        {
          "name": "KIWOOM_COLLECTOR_ENABLED",
          "value": "false"
        },
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        },
        {
          "name": "HTTP_REQUEST_HISTOGRAM_ENABLED",
          "value": "true"
        },
        {
          "name": "SPRING_JPA_HIBERNATE_DDL_AUTO",
          "value": "none"
        },
        {
          "name": "SPRING_DATASOURCE_DRIVER_CLASS_NAME",
          "value": "com.mysql.cj.jdbc.Driver"
        },
        {
          "name": "REDIS_PORT",
          "value": "6379"
        },
        {
          "name": "ELASTICACHE_CACHE_NAME",
          "value": "stockspoon-v2-prod-valkey"
        },
        {
          "name": "JAVA_TOOL_OPTIONS",
          "value": "-XX:MaxRAMPercentage=75"
        },
        {
          "name": "JPA_DDL_AUTO",
          "value": "none"
        },
        {
          "name": "REDIS_USERNAME",
          "value": "stockspoon-v2-prod-valkey-backend"
        },
        {
          "name": "REDIS_SSL",
          "value": "true"
        },
        {
          "name": "KIWOOM_STREAM_ENABLED",
          "value": "true"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "SPRING_DATASOURCE_URL",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:250832562715:parameter/stockspoon/v2/prod/backend/SPRING_DATASOURCE_URL"
        },
        {
          "name": "MYSQL_USER",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:250832562715:parameter/stockspoon/v2/prod/backend/MYSQL_USER"
        },
        {
          "name": "MYSQL_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:250832562715:parameter/stockspoon/v2/prod/backend/MYSQL_PASSWORD"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:250832562715:parameter/stockspoon/v2/prod/backend/JWT_SECRET"
        },
        {
          "name": "KAKAO_CLIENT_ID",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:250832562715:parameter/stockspoon/v2/prod/backend/KAKAO_CLIENT_ID"
        },
        {
          "name": "KAKAO_REDIRECT_URI",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:250832562715:parameter/stockspoon/v2/prod/backend/KAKAO_REDIRECT_URI"
        },
        {
          "name": "FRONTEND_ORIGIN",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:250832562715:parameter/stockspoon/v2/prod/backend/FRONTEND_ORIGIN"
        },
        {
          "name": "KAKAO_CLIENT_SECRET",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:250832562715:parameter/stockspoon/v2/prod/backend/KAKAO_CLIENT_SECRET"
        },
        {
          "name": "KIWOOM_APP_KEY",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:250832562715:parameter/stockspoon/v2/prod/backend/KIWOOM_APP_KEY"
        },
        {
          "name": "KIWOOM_APP_SECRET",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:250832562715:parameter/stockspoon/v2/prod/backend/KIWOOM_APP_SECRET"
        },
        {
          "name": "KIWOOM_COLLECTOR_URL",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:250832562715:parameter/stockspoon/v2/prod/backend/KIWOOM_COLLECTOR_URL"
        },
        {
          "name": "KIWOOM_COLLECTOR_SECRET",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:250832562715:parameter/stockspoon/v2/prod/backend/KIWOOM_COLLECTOR_SECRET"
        }
      ],
      "stopTimeout": 30,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/stockspoon-v2-prod/backend",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "backend"
        }
      },
      "systemControls": []
    }
  ],
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "EC2"
  ],
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  }
}
