# 체결 Application 전용 예시. 실제 비밀값을 Git에 커밋하지 않는다.
SERVER_PORT=8081
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/stockspoon
MYSQL_USER=
MYSQL_PASSWORD=
JPA_DDL_AUTO=validate
EXECUTION_INTERNAL_SECRET=
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_CLUSTER_MODE=false
# AWS Serverless IAM 배포에서는 인프라 값과 인스턴스 역할을 사용한다.
AWS_REGION=ap-northeast-2
ELASTICACHE_CACHE_NAME=
# 평가용 REST 조회는 기존 수집 담당 경계를 사용한다. AI 시세 서버 규격 확정 후 조정.
KIWOOM_COLLECTOR_URL=
KIWOOM_COLLECTOR_SECRET=
