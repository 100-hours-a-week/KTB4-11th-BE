# 배포 예시: 값은 실제 환경에 맞춰 비밀 관리 도구로 주입한다. 이 파일을 그대로 실행하지 않는다.
SPRING_DATASOURCE_URL=jdbc:mysql://REPLACE_WITH_HOST:3306/REPLACE_WITH_DATABASE
MYSQL_USER=REPLACE_WITH_USER
MYSQL_PASSWORD=
JPA_DDL_AUTO=validate

REDIS_HOST=stockspoon-v2-dev-valkey-kmikux.serverless.apn2.cache.amazonaws.com
REDIS_PORT=6379
REDIS_USERNAME=stockspoon-v2-dev-valkey-backend
# IAM에서는 고정 비밀번호를 사용하지 않는다. 로컬/비밀번호 방식에서만 설정한다.
REDIS_PASSWORD=
# 예시 값. 인프라에서 확인한 실제 TLS 사용 여부로 설정한다.
REDIS_SSL=true
REDIS_CLUSTER_MODE=true
AWS_REGION=ap-northeast-2
ELASTICACHE_CACHE_NAME=stockspoon-v2-dev-valkey

# 모든 BE에 같은 전용 비밀키를 주입한다.
KIWOOM_COLLECTOR_SECRET=
KIWOOM_STREAM_ENABLED=true

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=REPLACE_WITH_CALLBACK_URL
FRONTEND_ORIGIN=REPLACE_WITH_FRONTEND_ORIGIN
AUTH_COOKIE_SECURE=true
JWT_SECRET=
JWT_ISSUER=stockspoon
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=14d
